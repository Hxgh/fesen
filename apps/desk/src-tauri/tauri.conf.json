{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fesen",
  "version": "0.1.0",
  "identifier": "io.fesen.client",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "",
      "width": 430,
      "height": 740,
      "minWidth": 360,
      "minHeight": 540,
      "center": true,
      "titleBarStyle": "Overlay",
      "hiddenTitle": true,
      "trafficLightPosition": { "x": 16, "y": 28 }
    }],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self'; img-src 'self' data:; base-uri 'none'; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "14.0"
    },
    "android": {
      "minSdkVersion": 33
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["fesen"] },
      "mobile": [{ "scheme": ["fesen"], "host": "join", "appLink": false }]
    }
  }
}

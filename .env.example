# 飞弦（Fesen）配置示例
# 本机联调或部署请复制为 .env.local（已被 .gitignore 忽略，禁止提交真实隐私数据）。
# 本机私有调试文档可按需放在 .local/debug.md（允许不存在，不入 Git）。

# --- 服务端部署（deploy/compose.yaml）---
# 群组公网域名（A 记录指向服务器，放行 80/443 TCP）
FESEN_DOMAIN=group.example.com
# 可选：直接使用 GHCR 预构建镜像（未设置时默认本地源码构建）
# FESEN_IMAGE=ghcr.io/<owner>/<repo>-server:latest
# 可选：指定外部 STUN 协助 IPv4 NAT 穿透（默认不启用）
# FESEN_STUN=stun.example.com:3478

# 单容器或原生运行 fesen-server 时的常用变量：
# FESEN_ORIGIN=https://group.example.com
# FESEN_LISTEN=0.0.0.0:8443
# FESEN_DB=/state/fesen.sqlite
# FESEN_TLS_CERT=/certs/fullchain.pem
# FESEN_TLS_KEY=/certs/privkey.pem
# FESEN_UDP=0.0.0.0:4455
# FESEN_PUBLIC_UDP_PORT=4455

# --- 本机实机联调 / WebView 验收（仅本机 .env.local 使用）---
# 指向局域网内用于验收测试的目标 HTTP 服务（不要提交真实内网 IP）
FESEN_LAB_TARGET_IP=198.51.100.10
FESEN_LAB_TARGET_PORT=8080
FESEN_LAB_TARGET_NAME=lab-http

# --- 客户端本地正式签名打包（CI 中统一通过 GitHub Secrets 注入）---
# macOS 14+ Apple Silicon（scripts/build-macos.sh，省略时使用 --unsigned 构建本地测试包）
# FESEN_TEAM_ID=
# FESEN_SIGN_ID=
# FESEN_HOST_PROFILE=
# FESEN_TUNNEL_PROFILE=

# Android 13+ ARM64（scripts/build-android.sh，省略时构建 debug 或 unsigned release APK）
# FESEN_ANDROID_KEYSTORE=
# FESEN_ANDROID_KEYSTORE_PASS=
# FESEN_ANDROID_KEY_ALIAS=
# FESEN_ANDROID_KEY_PASS=
